# Copy this file to .env and fill in real values.
# Never commit the real .env file to git.
# Database connection string (MongoDB Atlas or local MongoDB)
# For explicit in-memory tests, use: mongomock://local
# start-local.ps1 uses the persistent MongoDB service from compose.local.yml.
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.floaexc.mongodb.net/chartcoach?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=chartcoach
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
# Set to true once the site runs over HTTPS in production
COOKIE_SECURE=false
APP_ENVIRONMENT=development
# mux is the default. local is rejected unless APP_ENVIRONMENT is development/test.
PLAYBACK_PROVIDER=mux
MEDIA_ROOT=../.media

# Optional Mux DRM playback signing. Keep the decoded private key server-side.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY_BASE64=
MUX_PLAYBACK_TOKEN_EXPIRE_MINUTES=120
MUX_PLAYBACK_RESTRICTION_ID=
